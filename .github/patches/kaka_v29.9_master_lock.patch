+
+// ==========================================
+// 一键霸麦锁定：一次锁死清晰度/响度/护盾/伴奏联动参数
+// 原则：不靠 tanhf 硬削波换响度，靠前瞻限幅 + 中高频提亮换穿透力
+// ==========================================
+static void kp_toggle_master_lock(BOOL lock) {
+    g_oneTapMasterLock = lock;
+    if (lock) {
+        g_dspEnabled       = YES;
+        g_losslessPriority = YES;
+        g_priorityLoud     = YES;
+        g_lowCutEnabled    = YES;
+        g_gateEnabled      = NO;      // 多人抢麦时避免吞字
+        g_throatEnabled    = YES;
+        g_compEnabled      = YES;
+        g_compThresh       = 0.22f;
+        g_compRatio        = 4.5f;
+        g_eq10Enabled      = YES;
+        g_limiterEnabled   = YES;
+        g_limiterCeiling   = 31100.0f; // 约 -0.5dBFS，留 0.5dB 余量杜绝方波
+        g_makeupGain       = 2.1f;     // 黄金增益，配合 RMS 护栏保动态
+        g_tubeEnabled      = YES;
+        g_tubeDrive        = 3.0f;     // 轻驱动只为偶次谐波增厚
+        g_tubeWet          = 0.18f;    // 高 wet 必糊，锁死在 18%
+
+        // 远端护盾：把别人声音压低到 20%，避免外放/耳返回声抑制
+        g_shieldRemote     = YES;
+        g_shieldLowOnly    = YES;
+        kp_shield_apply();
+
+        // BGM 联动避让
+        if (g_bgmMasterSync) g_duckEnabled = YES;
+
+        // 锁死 10 段曲线：削 120Hz 以下浑浊，2.5k/4.2k 提亮穿透
+        static const float masterEq[EQ10_BANDS] = {
+            -6.0f, -3.5f, -1.0f, 0.5f, 1.5f, 3.5f, 4.8f, 3.5f, 2.0f, 1.0f
+        };
+        for (int i = 0; i < EQ10_BANDS; i++) {
+            g_eq10Gains[i] = masterEq[i];
+        }
+        kp_rebuild_filter_bank();
+        kp_log(@"[MASTER-LOCK] 一键霸麦已锁定：清晰度+穿透力+伴奏联动全开");
+    } else {
+        g_shieldRemote = NO;
+        kp_shield_apply();
+        kp_log(@"[MASTER-LOCK] 已解除一键锁定，恢复自定义调节");
+    }
+    save_current_settings();
+    kp_update_ball();
 }
 
